# Copy to .env and fill in. Without an LLM key the dispatcher runs with the rule parser.
LLM_PROVIDER=                 # anthropic | gemini | empty = whichever key is set (Anthropic first)
GEMINI_API_KEY=               # free key from Google AI Studio
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
DISPATCH_MODEL=claude-opus-5-5
DISPATCH_EFFORT=medium        # Anthropic only

DISPATCHER_DB=dispatcher.db
SEED=1                        # which synthetic delivery day to load on first start
SOLVE_SECONDS=10              # OR-Tools time limit for the daily plan
SIM_CLOCK=10:00               # default time of day for commands without a clock

DISTANCE_PROVIDER=            # empty = straight-line x 1.32 with a speed profile; osrm = road network
OSRM_URL=http://localhost:5000
